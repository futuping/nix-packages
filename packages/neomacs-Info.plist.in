<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Neomacs</string>
  <key>CFBundleDisplayName</key>
  <string>Neomacs</string>
  <key>CFBundleIdentifier</key>
  <string>org.neomacs.nix</string>
  <key>CFBundleExecutable</key>
  <string>neomacs-launcher</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleVersion</key>
  <string>@appVersion@</string>
  <key>CFBundleShortVersionString</key>
  <string>@appVersion@</string>
  <key>CFBundleGetInfoString</key>
  <string>Neomacs @upstreamVersion@ (Nix)</string>
  <key>CFBundleIconFile</key>
  <string>neomacs</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- The real Neomacs session supplies its window and Dock entry. -->
  <key>LSUIElement</key>
  <true/>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Text and source files</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.text</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Additional text and source files</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <!--
        Text/code extensions follow GNU Emacs' macOS declaration, supplemented
        with Markdown, Nix and other common plain-text formats:
        https://github.com/emacs-mirror/emacs/blob/master/nextstep/templates/Info.plist.in

        Keep this entry separate: LSItemContentTypes takes precedence over
        CFBundleTypeExtensions in the same document-type dictionary.
      -->
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>ada</string>
        <string>adb</string>
        <string>ads</string>
        <string>asm</string>
        <string>asp</string>
        <string>bash</string>
        <string>bib</string>
        <string>c</string>
        <string>c++</string>
        <string>cc</string>
        <string>conf</string>
        <string>cp</string>
        <string>cpp</string>
        <string>csh</string>
        <string>css</string>
        <string>csv</string>
        <string>ctx</string>
        <string>cxx</string>
        <string>dtd</string>
        <string>dtx</string>
        <string>el</string>
        <string>f</string>
        <string>f77</string>
        <string>f90</string>
        <string>f95</string>
        <string>f99</string>
        <string>fish</string>
        <string>for</string>
        <string>go</string>
        <string>gp</string>
        <string>h</string>
        <string>h++</string>
        <string>hh</string>
        <string>hp</string>
        <string>hpp</string>
        <string>hs</string>
        <string>htm</string>
        <string>html</string>
        <string>hxx</string>
        <string>ini</string>
        <string>jav</string>
        <string>java</string>
        <string>js</string>
        <string>json</string>
        <string>jsp</string>
        <string>jsx</string>
        <string>latex</string>
        <string>lhs</string>
        <string>log</string>
        <string>ltx</string>
        <string>lua</string>
        <string>m</string>
        <string>markdown</string>
        <string>md</string>
        <string>mdown</string>
        <string>mkd</string>
        <string>mkdn</string>
        <string>nix</string>
        <string>org</string>
        <string>pas</string>
        <string>php</string>
        <string>php3</string>
        <string>php4</string>
        <string>pl</string>
        <string>pm</string>
        <string>pro</string>
        <string>py</string>
        <string>rb</string>
        <string>rdf</string>
        <string>rs</string>
        <string>s</string>
        <string>sgm</string>
        <string>sgml</string>
        <string>sh</string>
        <string>shtm</string>
        <string>shtml</string>
        <string>sty</string>
        <string>tcl</string>
        <string>tex</string>
        <string>texi</string>
        <string>text</string>
        <string>toml</string>
        <string>ts</string>
        <string>tsv</string>
        <string>tsx</string>
        <string>txt</string>
        <string>xbl</string>
        <string>xhtm</string>
        <string>xhtml</string>
        <string>xml</string>
        <string>xsd</string>
        <string>xsdl</string>
        <string>xsl</string>
        <string>xslt</string>
        <string>xul</string>
        <string>yaml</string>
        <string>yml</string>
        <string>zsh</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Other files</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <!-- Include unknown/extensionless flat files, not folders or app bundles. -->
      <key>LSItemContentTypes</key>
      <array>
        <string>public.data</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
